# Environment variables for local development
# Copy to .env.local and update values

# Keycloak Configuration
VITE_KEYCLOAK_URL=https://id.oasysic.net
VITE_KEYCLOAK_REALM=oil
VITE_KEYCLOAK_CLIENT_ID=pipeline-portal

# API Configuration (for local dev with proxy)
VITE_API_URL=

# GitHub Token (optional - increases rate limits for live run fetching)
# Get a token from: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=

# For local development against mock data
# VITE_API_URL=http://localhost:3001
